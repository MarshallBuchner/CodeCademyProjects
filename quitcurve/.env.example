# Supabase (optional — enables cross-device sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL (for OG tags, sitemap, reminder links)
NEXT_PUBLIC_SITE_URL=https://quitcurve.app

# --- Check-in reminders (server-only) ---
# Service role key: Supabase → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects /api/cron/reminders (Vercel Cron sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate-a-long-random-string

# Resend (same key as magic-link SMTP, or a dedicated sending key)
RESEND_API_KEY=re_xxxxxxxx
REMINDER_FROM_EMAIL=QuitCurve <noreply@quitcurve.app>

# Optional SMS via Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
